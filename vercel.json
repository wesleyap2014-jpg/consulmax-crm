{
  "framework": "vite",
  "buildCommand": "npm install && node scripts/apply-vercel-build-patches.mjs && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/robots/sync-groups.ts": {
      "maxDuration": 60
    },
    "api/agenda/birthday-whatsapp.ts": {
      "maxDuration": 300
    },
    "api/marketing/newsletter-dispatch-run.ts": {
      "maxDuration": 60
    },
    "api/marketing/radar-run.ts": {
      "maxDuration": 60
    },
    "api/whatsapp/campaign-run.ts": {
      "maxDuration": 300
    },
    "api/whatsapp/campaign-cron.ts": {
      "maxDuration": 300
    },
    "api/marketing/creative-max.ts": {
      "maxDuration": 90
    },
    "api/weekly-performance-feedback.ts": {
      "maxDuration": 300
    },
    "api/carteira/relationship-ruler.ts": {
      "maxDuration": 300
    },
    "api/carteira/relationship-cta.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/agenda/birthday-whatsapp",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/marketing/newsletter-dispatch-run",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/marketing/radar-run",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/whatsapp/campaign-cron",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/weekly-performance-feedback",
      "schedule": "0 21 * * 5"
    },
    {
      "path": "/api/carteira/relationship-ruler",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
