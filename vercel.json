{
  "framework": "vite",
  "buildCommand": "npm install && node scripts/patch-maggi-lead-select.mjs && node scripts/patch-marketing-newsletter-templates-v1.mjs && node scripts/patch-newsletter-test-only-v1.mjs && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/robots/sync-groups.ts": {
      "maxDuration": 60
    },
    "api/agenda/birthday-whatsapp.ts": {
      "maxDuration": 300
    },
    "api/marketing/newsletter-dispatch-run.ts": {
      "maxDuration": 60
    },
    "api/whatsapp/campaign-run.ts": {
      "maxDuration": 300
    },
    "api/whatsapp/campaign-cron.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/agenda/birthday-whatsapp",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/marketing/newsletter-dispatch-run",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/whatsapp/campaign-cron",
      "schedule": "*/2 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/.*)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
